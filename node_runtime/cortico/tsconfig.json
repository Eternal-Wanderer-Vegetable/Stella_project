{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": false,
    "baseUrl": ".",
    "paths": {
      "cortico/*": ["../../vendor/cortico/src/*"]
    }
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts"]
}
