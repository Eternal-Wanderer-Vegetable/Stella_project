{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stella Runtime State",
  "type": "object",
  "required": ["schema_version", "instance_id", "desired", "updated_at", "components"],
  "properties": {
    "schema_version": {"const": 1},
    "instance_id": {"type": "string", "minLength": 1},
    "desired": {"enum": ["disabled", "stopped", "starting", "running", "healthy", "degraded", "failed"]},
    "updated_at": {"type": "string", "minLength": 1},
    "components": {
      "type": "object",
      "propertyNames": {"enum": ["stella", "llama", "onebot"]},
      "additionalProperties": {
        "type": "object",
        "required": ["state"],
        "properties": {
          "state": {"enum": ["disabled", "stopped", "starting", "running", "healthy", "degraded", "failed"]},
          "pid": {"type": "integer", "minimum": 1},
          "endpoint": {"type": "string"},
          "error": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": {"type": "string", "minLength": 1},
              "message": {"type": "string", "maxLength": 500},
              "details": {"type": "object"}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
