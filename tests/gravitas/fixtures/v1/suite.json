        "tests/test_scheduler_concurrency.py::test_online_limit_admits_exactly_that_many",
        "tests/gravitas/test_g03_model_calls.py::test_executor_defers_when_bounded_queue_is_full"
      ]
    },
    {
      "id": "S05",
      "name": "background fairness",
      "required_invariants": ["I02", "I05"],
