{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stella",
  "mainBinaryName": "Stella",
  "version": "5.0.0",
  "identifier": "com.stella.desktop",
  "build": {
    "frontendDist": "../dashboard-dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Stella",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: http://127.0.0.1:*; connect-src 'self' http://127.0.0.1:* ws://127.0.0.1:*; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "resources/stella"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}