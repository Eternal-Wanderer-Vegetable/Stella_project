# ============================================================
# Stella 配置示例（复制为 .env 后按需修改）
# .env 包含真实敏感值，已被 git 忽略；本示例文件可以安全提交。
# 所有键均可选，缺省时使用 config/settings.py 中的默认值。
# ============================================================

# ---------- 运行环境 ----------
# ENVIRONMENT=dev                # dev 加载 .env.dev，prod 加载 .env.prod
DRIVER=~fastapi+~websockets

# ---------- OneBot V11 连接（NapCat 侧需先在 NapCatQQ Desktop 完成登录） ----------
# Bot 通过 OneBot V11 WebSocket 与 NapCat 通信，两种方向二选一。
#
# 方式 A：反向 WS（推荐，Bot 做 WS 服务端）
#   Bot 侧：HOST 监听地址 + PORT 端口（NoneBot 默认 0.0.0.0:8080），
#   反向 WS 端点固定为 /onebot/v11/ws。
#   NapCat 侧：网络配置 → 添加「WebSocket 客户端」，URL 填
#     ws://<Bot 地址>:<PORT>/onebot/v11/ws
#     例：Bot 与 NapCat 同机 → ws://127.0.0.1:8080/onebot/v11/ws
HOST=0.0.0.0
PORT=8080
#
# 方式 B：正向 WS（Bot 做 WS 客户端，主动连接 NapCat 的 WS 服务端）
#   NapCat 侧：网络配置 → 开启「WS 服务端」，记下监听地址与 token。
#   Bot 侧：取消下面两行注释（JSON 数组，可填多个地址）。
# ONEBOT_WS_URLS=["ws://127.0.0.1:3001"]
# ONEBOT_ACCESS_TOKEN=
#
# 无论哪种方式：若两侧都配了 access token，两边的值必须一致。

# ---------- 允许响应的 QQ 群号（必填，逗号分隔多个） ----------
ALLOWED_GROUPS=123456789

# ---------- OneBot 链路监测（只告警，不重启） ----------
LINK_MONITOR_ENABLED=true
LINK_MONITOR_TIMEOUT=300
LINK_MONITOR_CHECK_INTERVAL=60
LINK_MONITOR_ALERT_INTERVAL=300

# ---------- 文件路径（默认锚定项目根目录，可覆盖为绝对路径） ----------
# SYSTEM_PROMPT_PATH=
# DB_PATH=
# THOUGHT_LOG_PATH=
# EXTENSIONS_DIR=
# CONSOLIDATION_LOG_PATH=

# ---------- 本地 LLM（LM Studio） ----------
LM_STUDIO_BASE_URL=http://127.0.0.1:1234
# 多模型加载时聊天必须显式指定完整模型 ID（含 provider 前缀）
LM_STUDIO_MODEL=google/gemma-4-26b-a4b-qat
LLM_TIMEOUT=90

# ---------- 记忆整合（本地 LM Studio，在线整合已废弃） ----------
# CONSOLIDATION_LM_STUDIO_BASE_URL=
CONSOLIDATION_LM_STUDIO_MODEL=google/gemma-4-e4b
CONSOLIDATION_LM_STUDIO_TEMPERATURE=0.3
CONSOLIDATION_LOCAL_BATCH_SIZE=30
CONSOLIDATION_LOCAL_FORCE_BATCH_SIZE=10
CONSOLIDATION_OVERLAP=15
CONSOLIDATION_LOCAL_MAX_TOKENS=1200
# 定时整合（排空积压）的检查间隔（秒）与单次最多批数
# CONSOLIDATION_SCHEDULE_INTERVAL=120
# CONSOLIDATION_MAX_ROUNDS_PER_RUN=3
# 积压超过该条数时日志提升为 warning
# CONSOLIDATION_BACKLOG_WARN=300

# ---------- 记忆候选提取（两阶段整合的第二阶段） ----------
# 整合拆两步：阶段1（整合模型）出摘要/画像/自我披露判断；
# 阶段2（本段模型）只做一件高精度的事——精确提取记忆候选。
# 默认全部继承主聊天模型配置。
MEMORY_EXTRACT_ENABLED=true
# MEMORY_EXTRACT_LM_STUDIO_BASE_URL=http://127.0.0.1:1234
# MEMORY_EXTRACT_LM_STUDIO_MODEL=your-chat-model
# MEMORY_EXTRACT_LM_STUDIO_API_KEY=
MEMORY_EXTRACT_LM_STUDIO_TEMPERATURE=0.2
MEMORY_EXTRACT_MAX_TOKENS=1000

# ---------- LLM 资源调度（模型级串行闸门） ----------
# LM Studio 不限制并发：多请求同时打到同一模型会并发推理、互相拖慢。
# 因此每个模型一道闸门，一次只处理一个任务；两个模型彼此并行。
LLM_SCHEDULER_WAIT_WARN_SECONDS=30.0
LLM_SCHEDULER_HOLD_WARN_SECONDS=90.0
LLM_SCHEDULER_QUEUE_WARN_DEPTH=3
# 优先级排队尚未实现，保留开关
LLM_SCHEDULER_PRIORITY_ENABLED=false
# embedding 默认与主聊天同一实例，一次检索可编码 20+ 条；独立实例部署时可关
LLM_SCHEDULER_GATE_EMBEDDING=true

# ---------- 主动发言 ----------
# 主动发言规则：按群聊消息频率插话（双锚点曲线，见下方「主动发言 v2」）——
# 频率越高越可能开口；消息稀疏到 INTERVAL_SLOW 锚点（平均间隔 >= INTERVAL_SLOW）时完全闭嘴。
# PROACTIVE_ENABLED=true
# PROACTIVE_COOLDOWN=600
# PROACTIVE_CHECK_INTERVAL=60
# 距上次自己发言，群里至少要有多少条新消息才允许再开口；0 表示不限制
# PROACTIVE_MIN_MESSAGES_SINCE_SPOKE=15
# PROACTIVE_FREQ_WINDOW=10
# PROACTIVE_MAX_LINES=1
# CONSOLIDATION_TRIGGER_NEW_MESSAGES=10

# ---------- 主动发言：睡眠时段 ----------
# 睡眠期间关闭一切主动发言（话题插话 + 主动 @），但被 @ 时照常回复；
# 被动信息收集（消息落库、整合）在睡眠期照常进行。
# PROACTIVE_SLEEP_ENABLED=true
# 睡眠起止（HH:MM，本地时间；START > END 时视为跨天区间）
# PROACTIVE_SLEEP_START=23:30
# PROACTIVE_SLEEP_END=07:30
# 醒来缓冲（秒）：苏醒后不立刻恢复主动发言，避免积压一夜的活跃度让它连发几句
# PROACTIVE_WAKEUP_GRACE_SECONDS=900.0
# 是否在入睡/苏醒时向群里播报一句
# PROACTIVE_SLEEP_ANNOUNCE=true
# 播报台词（逗号分隔多条，随机选一条；留空则不播报对应时段）
# PROACTIVE_SLEEP_MESSAGES=我先去睡了，晚安~,有点困了，明天聊,睡觉去了，你们别聊太晚
# PROACTIVE_WAKEUP_MESSAGES=早，我回来了,睡醒了，早上好,起床了~

# ---------- 主动发言：运行时开关 ----------
# 管理员可在群内临时关闭主动发言（持久化在 group_runtime_state 表，重启后仍生效）
# PROACTIVE_RUNTIME_TOGGLE_ENABLED=true
# 允许操作运行时开关的用户（QQ 号，逗号分隔）。留空则仅群主/管理员可操作。
# PROACTIVE_TOGGLE_ADMINS=

# ---------- 上下文 ----------
# 每次回复附加的最近原始消息条数（含 Bot 自己发言），补足摘要的滞后。
# 太小活跃群刷屏会把 Bot 提问挤出窗口、太大无关历史干扰模型，12 是起点。
# RECENT_TAIL_LIMIT=12
# 原始尾巴的时间窗（分钟）：超出该时长的消息不再算作「最近的对话」；0 不做时间过滤
# RECENT_TAIL_MAX_AGE_MINUTES=45.0
# 相邻消息间隔超过该分钟数时，在尾巴里插入断层标记；0 关闭
# RECENT_TAIL_GAP_MARK_MINUTES=15.0
# 话题摘要超过该分钟数未更新时，标题改为「之前的话题」并注明时长；0 关闭
# SHORT_TERM_SUMMARY_STALE_MINUTES=60.0

# ---------- 会话上下文压缩 ----------
# 短时连续对话中早期消息滚出尾巴窗口后会被压缩成摘要，保证长对话连贯。
# 会话摘要（已压缩部分）与原始尾巴按消息 id 严格划分、绝不重叠。
# SESSION_CONTEXT_ENABLED=true
# 待压缩文本超过该 token 估算值才触发压缩（不是每轮都压缩）
# SESSION_COMPACT_THRESHOLD_TOKENS=600
# 摘要自身的 token 预算：超过则连同新内容重新压缩一次
# SESSION_SUMMARY_MAX_TOKENS=300
# 单次压缩最多喂入多少条消息，防止长时间未压缩后一次性过大
# SESSION_COMPACT_MAX_MESSAGES=60
# 空闲多久视为会话结束（秒）：结束时清空摘要并触发一次完整整合
# SESSION_IDLE_TIMEOUT_SECONDS=900.0
# 空闲检查间隔（秒）
# SESSION_IDLE_CHECK_INTERVAL=300

# ---------- 主动发言 v2：话题参与概率曲线（双锚点插值） ----------
# 同一条曲线通过参数即可表达两种意图，无需模式开关：
#   「热闹时插话」（新默认）：PROB_AT_FAST=0.35, PROB_AT_SLOW=0.0
#   「热闹时闭嘴」（旧行为）：PROB_AT_FAST=0.05, PROB_AT_SLOW=0.5
#   完全关闭：两个锚点都设 0
# PROACTIVE_INTERVAL_FAST=20.0
# PROACTIVE_INTERVAL_SLOW=180.0
# PROACTIVE_PROB_AT_FAST=0.15   # 0.35 偏吵，0.15 为调低后的默认值
# PROACTIVE_PROB_AT_SLOW=0.0
# 曲线整形指数：1.0 线性；>1 把高概率压缩到最活跃一端（更保守）；<1 更平坦
# PROACTIVE_PROB_GAMMA=1.0
# 话题预热：话题刚开始时模型总结不出主题，贸然插话会答非所问
# PROACTIVE_TOPIC_WARMUP_SECONDS=45.0

# ---------- 主动发言 v2：每用户 @ 配额 ----------
# 主动 @ 是侵入性最强的行为，必须有硬上限。基础 2 次/天，高频发言者小幅上浮，
# 上限封顶在 BASE+BONUS_MAX，杜绝「越活跃越被骚扰」。
# PROACTIVE_AT_ENABLED=true
# PROACTIVE_AT_QUOTA_BASE=2
# PROACTIVE_AT_QUOTA_BONUS_MAX=2
# PROACTIVE_AT_BONUS_MSGS_LOW=20
# PROACTIVE_AT_BONUS_MSGS_HIGH=100
# 同一用户两次主动 @ 的最小间隔（秒），默认 2 小时
# PROACTIVE_AT_USER_COOLDOWN=7200.0
# 判定「正在活跃」的时间窗（秒）
# PROACTIVE_AT_ACTIVE_WITHIN=300.0
# 连续无回应上限：超过则暂停对该用户的主动 @
# PROACTIVE_MAX_NO_REPLY=2
# 回应检测窗口（秒）
# PROACTIVE_REPLY_WINDOW_SECONDS=300.0
# 冷启动话题清单（无候选可验证时用，逗号分隔）
# PROACTIVE_COLDSTART_TOPICS=最近在玩什么游戏,平时喜欢吃什么,今天天气怎么样,最近在忙什么,平时用什么设备
# 主动 @ 的排除名单（QQ 号，逗号分隔）：主要用途是排除群内其他 AI，
# 互相 @ 会触发无终止的循环对话。被排除的账号仍会被动收集信息。
PROACTIVE_AT_EXCLUDE_USERS=

# ---------- 输出 ----------
# MAX_REPLY_LINES=5
# SEND_INTERVAL=0.8

# ---------- 记忆系统 v2（可调阈值，越高越保守） ----------
# Mode 检测打分制的最低分：低于该值的信号不值得把模式从 CASUAL_REPLY 改判
# MODE_DETECT_MIN_SCORE=0.5
# 记忆进入 Prompt 的最低排序分（宁缺毋滥，配合 --verbose 的 scores 分布来调）
# MEMORY_SCORE_MIN=0.40

# ---------- 消息来源分级（source_kind，默认开启） ----------
# @ 对话是唯一稳定的用户信息源，被动摄入的群聊多为角色扮演、可提取信息极少。
# 关闭后 prompt 不标注来源、候选不加置信度奖励（退回旧「消息等权」行为），
# 但 schema 的 source_kind 字段仍会写入，便于审计回看。
# MEMORY_SOURCE_KIND_ENABLED=true
# AT_MENTION 来源候选的置信度奖励（仅微调，默认 0.05）
# MEMORY_AT_MENTION_CONFIDENCE_BONUS=0.05

# ---------- 候选强化（交叉验证） ----------
# 同一事实被再次独立观察到时的置信度增益（默认 0.12：0.5 起步约 2 次复现后跨过 0.6 观察门槛）
# MEMORY_CANDIDATE_REOCCURRENCE_BONUS=0.12
# 候选在 OBSERVING 停留的最长天数，超期未获新证据即标 REJECTED（默认 30）
# MEMORY_CANDIDATE_MAX_OBSERVING_DAYS=30
# evidence 字段累积上限（字符），防止多次复现导致的无限增长（默认 800）
# MEMORY_CANDIDATE_EVIDENCE_MAX_CHARS=800

# ---------- 晋升门槛（Gate 1 三档分级） ----------
# 纯 PASSIVE 来源晋升所需的最低独立观察次数（默认 2：复现才是证据，单次陈述不算）
# MEMORY_PROMOTE_MIN_OCCURRENCE_PASSIVE=2
# AT_MENTION（用户直接对 Bot 说）是高密度证据，单次即可晋升（默认 true；
# 关闭后与 PASSIVE 同等对待、仍需复现）
# MEMORY_PROMOTE_AT_MENTION_SINGLE_SHOT=true
# 晋升所需的最低重要度，淘汰过于琐碎的信息（默认 0.3；不单独构成晋升依据）
# MEMORY_PROMOTE_MIN_IMPORTANCE=0.3

# ---------- 每用户记忆配额（宁缺毋滥的硬约束） ----------
# 是否真正执行淘汰。建议先保持 false 观察日志：以 dry-run 输出「本来会淘汰谁」，
# 确认淘汰对象合理后再打开。打开后超额记忆置 archived（不删除，但退出检索）。
# MEMORY_QUOTA_ENFORCE=false
# 单用户在单群的 active 记忆上限，到顶后新记忆挤掉现存最弱的一条（默认 25）
# MEMORY_USER_QUOTA=25
# 配额淘汰排序权重（得分最低者先被挤掉）：
#   importance=信息本身多重要；confirmation=被反复确认次数（最硬证据）；
#   recency=最近是否仍被触达（久未触碰价值衰减）
# MEMORY_QUOTA_W_IMPORTANCE=0.4
# MEMORY_QUOTA_W_CONFIRMATION=0.3
# MEMORY_QUOTA_W_RECENCY=0.3
# confirmation_count 归一化上限：达到该次数即视为充分确认（满分）（默认 3）
# MEMORY_QUOTA_CONFIRMATION_CAP=3

# ---------- 记忆语义检索（可选，Embedding） ----------
# 默认关闭：语义分用规则版（词面 Jaccard，离线）。打开后走本地 LM Studio /v1/embeddings
# 计算查询与记忆的余弦相似度，语义分真正可区分；模型不可用时自动回退规则版。
# MEMORY_EMBEDDING_ENABLED=false
# MEMORY_EMBEDDING_BASE_URL=http://127.0.0.1:1234
# MEMORY_EMBEDDING_MODEL=
# MEMORY_EMBEDDING_TIMEOUT=10.0
# embedding 路径下 CONTEXTUAL 记忆的主题匹配阈值（余弦）；rule-only 用 policy 内置 0.05
# MEMORY_EMBEDDING_CONTEXTUAL_MIN=0.25

# ---------- 数据库清理（测试期用，默认关闭） ----------
# DB_CLEANUP_ON_START=false
# DB_CLEANUP_CLEAR_MESSAGES=false

# ---------- 消息表定期清理 ----------
# 是否启用 group_messages 定期清理（每天定时清理）
# MESSAGE_CLEANUP_ENABLED=true
# 每个群保留的最近消息条数（超出部分删除）
# MESSAGE_CLEANUP_KEEP_COUNT=1000
# 定时清理执行时间（24 小时制）
# MESSAGE_CLEANUP_HOUR=4
# 清理时是否保护未整合的消息（checkpoint 之后的消息不删除，默认 true）
# MESSAGE_CLEANUP_PROTECT_UNCONSOLIDATED=true

# ============================================================
# 群组共享空间（不在本文件配置）
# ============================================================
# 多个 QQ 群可归入同一「共享空间」以共享用户画像、长期记忆与人格。
# 配置在 config/spaces/*.toml（空间名、system prompt 文件、群号），不走 .env。
# 默认人格文件为项目根目录 system_prompts/default.md；缺失时最后回退 memory/SYSTEM.md。
# 未被任何 toml 收录的群会自动分配 space_N 并持久化。
# 详见 docs/configuration.md 的「群组共享空间」一节。

# ---------- 结构化日志（供 GUI / 前端消费，默认开启） ----------
# 与人类可读日志并存：这份是给程序读的，GUI 靠它做级别过滤与错误复制。
# STELLA_JSON_LOG_ENABLED=true
# STELLA_JSON_LOG_PATH=logs/stella.jsonl
# 单条消息的截断长度（prompt 全文动辄数千字符，进结构化日志只会让文件暴涨）
# STELLA_JSON_LOG_MAX_MESSAGE=500

# ---------- 本地状态接口 ----------
# 挂在 NoneBot 已有的 ASGI app 上（HOST:PORT/stella/status），不新增端口。
# 只接受回环地址的请求，且响应体不含凭据与群聊内容——HOST 可能是 0.0.0.0，
# 那时本路由也会暴露到局域网。供 deploy status 与 GUI 读取进程内状态。
# STELLA_STATUS_API_ENABLED=true
# STELLA_STATUS_API_PATH=/stella/status

# ---------- 优雅停止 ----------
# 停止时等待在途后台任务（整合/压缩）收尾的上限（秒）。
# LLM 单次调用最长 120s×3 次重试，无限等待会让「停止」看起来卡死。
# SHUTDOWN_GRACE_SECONDS=30.0
# 停止请求哨兵路径（deploy stop 写入、Bot 内 watcher 观察后自行退出）。
# 默认项目根 .stella-stop-request；项目目录只读时可改到可写位置。
# STELLA_STOP_SENTINEL=
# 哨兵轮询间隔（秒）。
# STOP_WATCH_INTERVAL_SECONDS=0.5

# ---------- AstrBot 插件兼容层 ----------
# 将 AstrBot 生态的第三方插件直接放入 data/plugins/<插件目录>/ 即可。
# 仅支持不依赖大模型能力的功能类插件；依赖模型的插件需官方移植。
# ASTRBOT_COMPAT_ENABLED=true
# ASTRBOT_COMPAT_VERSION=4.27.0
# ASTRBOT_PLUGINS_DIR=
# ASTRBOT_PLUGIN_CONFIG_DIR=
# ASTRBOT_PLUGIN_DATA_DIR=
# ASTRBOT_AUTO_INSTALL_REQUIREMENTS=false
