# ============================================================
# Stella 配置示例（复制为 .env 后按需修改）
# .env 包含真实敏感值，已被 git 忽略；本示例文件可以安全提交。
# 所有键均可选，缺省时使用 config/settings.py 中的默认值。
# ============================================================

# ---------- 运行环境 ----------
# ENVIRONMENT=dev                # dev 加载 .env.dev，prod 加载 .env.prod
DRIVER=~fastapi+~websockets

# ---------- 允许响应的 QQ 群号（必填，逗号分隔多个） ----------
ALLOWED_GROUPS=123456789

# ---------- NapCat 前端（NapCat.Shell）外部管理 ----------
# NapCat.Shell 安装目录（含 launcher-user.bat / NapCatWinBootMain.exe / napcat.mjs），
# 默认取项目根目录上一级下的 NapCat.Shell，可用绝对路径覆盖。
# NAPCAT_SHELL_PATH=E:\stella\NapCat.Shell
# 是否在机器人启动时自动拉起 NapCat（未在运行才拉起）
# NAPCAT_AUTO_START=true
# QQ 账号 + 密码：注入 NAPCAT_QUICK_ACCOUNT / NAPCAT_QUICK_PASSWORD，
# 外部重启后 NapCat 自动登录（快速登录失效时用密码回退登录）
# NAPCAT_QQ_ACCOUNT=
# NAPCAT_QQ_PASSWORD=
# 可选：密码的 32 位小写 MD5（优先于明文 NAPCAT_QQ_PASSWORD）
# NAPCAT_QQ_PASSWORD_MD5=

# ---------- NapCat 消息流看门狗（外部重启，不再走 WebUI API） ----------
# NAPCAT_WATCHDOG_TIMEOUT=300      # 超过该秒数无群消息判定链路中断
# NAPCAT_WATCHDOG_CHECK_INTERVAL=60
# NAPCAT_WATCHDOG_RESTART_COOLDOWN=120

# ---------- 文件路径（默认锚定项目根目录，可覆盖为绝对路径） ----------
# SYSTEM_PROMPT_PATH=
# DB_PATH=
# THOUGHT_LOG_PATH=
# EXTENSIONS_DIR=
# CONSOLIDATION_LOG_PATH=

# ---------- 本地 LLM（LM Studio） ----------
LM_STUDIO_BASE_URL=http://127.0.0.1:1234
# 多模型加载时聊天必须显式指定完整模型 ID（含 provider 前缀）
LM_STUDIO_MODEL=google/gemma-4-26b-a4b-qat
LLM_TIMEOUT=90

# ---------- 记忆整合（本地 LM Studio，在线整合已废弃） ----------
# CONSOLIDATION_LM_STUDIO_BASE_URL=
CONSOLIDATION_LM_STUDIO_MODEL=google/gemma-4-e4b
CONSOLIDATION_LM_STUDIO_TEMPERATURE=0.3
CONSOLIDATION_LOCAL_BATCH_SIZE=30
CONSOLIDATION_LOCAL_FORCE_BATCH_SIZE=10
CONSOLIDATION_OVERLAP=15
CONSOLIDATION_LOCAL_MAX_TOKENS=1200

# ---------- 主动发言 ----------
# 主动发言规则：消息频率过低（平均消息间隔 >= PROACTIVE_LOW_FREQ_INTERVAL）时完全不
# 主动发言；只有群聊频率高于该值时，才按概率（高频低概率、随间隔增大概率）插话。
# PROACTIVE_ENABLED=true
# PROACTIVE_COOLDOWN=120
# PROACTIVE_CHECK_INTERVAL=30
# PROACTIVE_FREQ_WINDOW=10
# PROACTIVE_HIGH_FREQ_INTERVAL=20.0
# PROACTIVE_LOW_FREQ_INTERVAL=180.0
# PROACTIVE_MAX_PROB=0.5
# PROACTIVE_MIN_PROB=0.05
# PROACTIVE_MAX_LINES=1
# CONSOLIDATION_TRIGGER_NEW_MESSAGES=10

# ---------- 输出 ----------
# MAX_REPLY_LINES=5
# SEND_INTERVAL=0.8

# ---------- 记忆系统 v2（可调阈值，越高越保守） ----------
# Mode 检测打分制的最低分：低于该值的信号不值得把模式从 CASUAL_REPLY 改判
# MODE_DETECT_MIN_SCORE=0.5
# 记忆进入 Prompt 的最低排序分（宁缺毋滥，配合 --verbose 的 scores 分布来调）
# MEMORY_SCORE_MIN=0.35

# ---------- 数据库清理（测试期用，默认关闭） ----------
# DB_CLEANUP_ON_START=false
# DB_CLEANUP_CLEAR_MESSAGES=false
