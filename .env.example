# ============================================================
# Stella 配置示例（复制为 .env 后按需修改）
# .env 包含真实敏感值，已被 git 忽略；本示例文件可以安全提交。
# 所有键均可选，缺省时使用 config/settings.py 中的默认值。
# ============================================================

# ---------- 运行环境 ----------
# ENVIRONMENT=dev                # dev 加载 .env.dev，prod 加载 .env.prod
DRIVER=~fastapi+~websockets

# ---------- OneBot V11 连接（NapCat 侧需先在 NapCatQQ Desktop 完成登录） ----------
# Bot 通过 OneBot V11 WebSocket 与 NapCat 通信，两种方向二选一。
#
# 方式 A：反向 WS（推荐，Bot 做 WS 服务端）
#   Bot 侧：HOST 监听地址 + PORT 端口（NoneBot 默认 0.0.0.0:8080），
#   反向 WS 端点固定为 /onebot/v11/ws。
#   NapCat 侧：网络配置 → 添加「WebSocket 客户端」，URL 填
#     ws://<Bot 地址>:<PORT>/onebot/v11/ws
#     例：Bot 与 NapCat 同机 → ws://127.0.0.1:8080/onebot/v11/ws
HOST=0.0.0.0
PORT=8080
#
# 方式 B：正向 WS（Bot 做 WS 客户端，主动连接 NapCat 的 WS 服务端）
#   NapCat 侧：网络配置 → 开启「WS 服务端」，记下监听地址与 token。
#   Bot 侧：取消下面两行注释（JSON 数组，可填多个地址）。
# ONEBOT_WS_URLS=["ws://127.0.0.1:3001"]
# ONEBOT_ACCESS_TOKEN=
#
# 无论哪种方式：若两侧都配了 access token，两边的值必须一致。

# ---------- 允许响应的 QQ 群号（必填，逗号分隔多个） ----------
ALLOWED_GROUPS=123456789

# ---------- OneBot 链路监测（只告警，不重启） ----------
LINK_MONITOR_ENABLED=true
LINK_MONITOR_TIMEOUT=300
LINK_MONITOR_CHECK_INTERVAL=60
LINK_MONITOR_ALERT_INTERVAL=300

# ---------- 文件路径（默认锚定项目根目录，可覆盖为绝对路径） ----------
# SYSTEM_PROMPT_PATH=
# DB_PATH=
# EXTENSIONS_DIR=

# ---------- 日志目录 ----------
# 所有运行期日志的唯一落点，改这一个就能把全部日志搬走：
#   logs/stella.jsonl                结构化日志（GUI 消费，10MB 轮转、保留 5 份）
#   logs/stella_thought_logs.md      思考/决策日志（每轮完整 prompt、路由判定、工具结果）
#   logs/memory_consolidation_log.md 记忆整合日志
#   logs/memory_compressor_log.md    记忆压缩日志
#   logs/boot_debug.log              启动诊断（每次启动清空重写）
#   logs/stella.pid                  进程 PID（不是日志，但同目录）
# 目录由写入方按需创建，不必手工建。
# LOG_DIR=
# 下面每一项都可以单独指到别处（留空即 LOG_DIR 下的默认文件名）
# THOUGHT_LOG_PATH=
# CONSOLIDATION_LOG_PATH=
# MEMORY_COMPRESS_LOG_PATH=
# BOOT_DIAG_LOG_PATH=
# 注意：MEMORY_COMPRESS_LOG_FILENAME 已废弃（它是文件名而不是路径），
# 改用上面的 MEMORY_COMPRESS_LOG_PATH。旧键留在 .env 里不报错但完全不生效，
# `python -m deploy doctor` 会提示。

# ---------- 本地 LLM（LM Studio） ----------
LM_STUDIO_BASE_URL=http://127.0.0.1:1234
# 多模型加载时聊天必须显式指定完整模型 ID（含 provider 前缀）
LM_STUDIO_MODEL=google/gemma-4-26b-a4b-qat
LLM_TIMEOUT=90

# ---------- 记忆整合（默认本地 LM Studio；改走在线见下方「角色」段） ----------
# CONSOLIDATION_LM_STUDIO_BASE_URL=
CONSOLIDATION_LM_STUDIO_MODEL=google/gemma-4-e4b
CONSOLIDATION_LM_STUDIO_TEMPERATURE=0.3
CONSOLIDATION_LOCAL_BATCH_SIZE=30
CONSOLIDATION_LOCAL_FORCE_BATCH_SIZE=10
CONSOLIDATION_OVERLAP=15
CONSOLIDATION_LOCAL_MAX_TOKENS=1200
# 定时整合（排空积压）的检查间隔（秒）与单次最多批数
# CONSOLIDATION_SCHEDULE_INTERVAL=120
# CONSOLIDATION_MAX_ROUNDS_PER_RUN=3
# 积压超过该条数时日志提升为 warning
# CONSOLIDATION_BACKLOG_WARN=300

# 整合走在线端点时的另一组批量（只在 LLM_ROLE_CONSOLIDATION_ENDPOINT 指向 ONLINE_* 时生效）。
# 在线按 token 计费，固定 prompt 成本按批摊薄——批量翻倍等于把每条消息摊到的固定成本砍半。
# ⚠️ 省钱只能靠加大批量，绝不能拉长 CONSOLIDATION_SCHEDULE_INTERVAL：厂商前缀缓存是
#    分钟级 TTL，间隔超过 TTL 后固定前缀就从缓存价回到全价，反而更贵。请保持 ≤ 4 分钟。
# CONSOLIDATION_ONLINE_BATCH_SIZE=60
# CONSOLIDATION_ONLINE_FORCE_BATCH_SIZE=30
# 0 = 不重叠（重叠消息每批都要重复计费，话题连续性由每批都在传的摘要承担）
# CONSOLIDATION_ONLINE_OVERLAP=0
# 整合前的本地零成本预筛连续跳过多少次后强制整合一次。
# 跳过时不推进 checkpoint（消息攒着不丢），这个上限保证最坏情况只是延迟、不是丢失。
# CONSOLIDATION_MAX_SKIP_STREAK=3

# ---------- 记忆候选提取（两阶段整合的第二阶段） ----------
# 整合拆两步：阶段1（整合模型）出摘要/画像/自我披露判断；
# 阶段2（本段模型）只做一件高精度的事——精确提取记忆候选。
# 默认全部继承主聊天模型配置。
MEMORY_EXTRACT_ENABLED=true
# MEMORY_EXTRACT_LM_STUDIO_BASE_URL=http://127.0.0.1:1234
# MEMORY_EXTRACT_LM_STUDIO_MODEL=your-chat-model
# MEMORY_EXTRACT_LM_STUDIO_API_KEY=
MEMORY_EXTRACT_LM_STUDIO_TEMPERATURE=0.2
MEMORY_EXTRACT_MAX_TOKENS=1000

# ---------- LLM 资源调度（模型级串行闸门） ----------
# LM Studio 不限制并发：多请求同时打到同一模型会并发推理、互相拖慢。
# 因此每个模型一道闸门，一次只处理一个任务；两个模型彼此并行。
LLM_SCHEDULER_WAIT_WARN_SECONDS=30.0
LLM_SCHEDULER_HOLD_WARN_SECONDS=90.0
LLM_SCHEDULER_QUEUE_WARN_DEPTH=3
# 优先级排队尚未实现，保留开关
LLM_SCHEDULER_PRIORITY_ENABLED=false
# 各端点的并发度（= 闸门宽度）在下面「LLM 端点」段里按槽配置。
# embedding 的闸门归属见「记忆语义检索」段的 MEMORY_EMBEDDING_GATE
# （取代旧布尔键 LLM_SCHEDULER_GATE_EMBEDDING，升级时会自动换过来）。

# ---------- LLM 端点（Endpoint） ----------
# 端点 = 一组连接参数：地址 + API key + 类型 + 并发度 + 超时。
# 它是两样东西的归属单位：
#   ① API key —— 不同 key 就是不同的前缀缓存域。对话与记忆各用一把 key，
#      两边的固定前缀才不会互相挤出缓存（这是「双 key」要求的落点）。
#   ② 闸门资源 —— 并发度就是该端点同时允许多少个请求在飞。
# 槽位固定 4 个：LOCAL / ONLINE_CHAT / ONLINE_MEMORY / EXTRA。
#
# **这一整段可以全部注释掉**：那时行为与只填上面 LM_STUDIO_* / CONSOLIDATION_* /
# MEMORY_EXTRACT_* 逐项等价，纯本地部署不需要动它。
# embedding 不在本体系内（恒定本地），见「记忆语义检索」段。

# 槽 LOCAL：本地 LM Studio。
# 地址与 key 留空即继承上面的 LM_STUDIO_BASE_URL / LM_STUDIO_API_KEY——
# **换本地地址改上面那两个就够**，不必也不建议在这里重复一遍：只改这里的话，
# 继承同一个父键的记忆整合 / 候选提取 / 插件调用还会指着旧地址。
# LLM_ENDPOINT_LOCAL_BASE_URL=
# 本地服务通常不校验 key；少数本地网关要求填 dummy key，那时填这里。
# LLM_ENDPOINT_LOCAL_API_KEY=
# 本槽默认模型 ID。**本机槽留空即可**：留空时每个角色各自回落到自己的旧键
# （LM_STUDIO_MODEL / ASTRBOT_LLM_MODEL / MEMORY_EXTRACT_LM_STUDIO_MODEL），
# 也就是改造前的行为。填了这里等于「本机槽统一用这一个模型」，会盖掉那些旧键。
# LLM_ENDPOINT_LOCAL_MODEL=
# local | online。运行时不靠「有没有 api_key」猜——本地网关要求 dummy key 时猜错
# 会漏发 reasoning_effort=none（本地推理模型把 token 全耗在思维链上）。
# GUI 里这项没有控件：本机/备用两张卡按地址推导，两张在线卡固定 online，保存时
# 覆盖这里的手写值。中转网关（地址在 127.0.0.1、却按上游厂商计费）请用在线卡。
# LLM_ENDPOINT_LOCAL_KIND=local
# 并发度。本地=1：共享同一份模型权重，并发推理只会一起变慢。
# LLM_ENDPOINT_LOCAL_CONCURRENCY=1
# 单次 HTTP 请求超时（秒）。与上面的 LLM_TIMEOUT **不是一回事**：后者是一整轮
# 回复的预算（含检索、工具、重试），这里只管一次 HTTP 往返。
# LLM_ENDPOINT_LOCAL_TIMEOUT=120.0

# 槽 ONLINE_CHAT：在线·对话域。持有「对话生成」那把 key。
# 只在需要把对话切到在线时才填；填了地址就必须填 key（启动校验会拦）。
# LLM_ENDPOINT_ONLINE_CHAT_BASE_URL=
# LLM_ENDPOINT_ONLINE_CHAT_API_KEY=
# 本槽的模型 ID。**在线槽写在这里就够了**，不必在每个角色上重复一遍：绑到本槽的
# 角色默认全用它。个别角色要换（例如兜底判定挑更便宜的那档），再写那个角色的
# LLM_ROLE_<角色>_MODEL 覆盖。
# LLM_ENDPOINT_ONLINE_CHAT_MODEL=
# LLM_ENDPOINT_ONLINE_CHAT_KIND=online
# 按厂商限流填；4 是保守默认值，不是厂商上限。
# LLM_ENDPOINT_ONLINE_CHAT_CONCURRENCY=4
# LLM_ENDPOINT_ONLINE_CHAT_TIMEOUT=120.0

# 槽 ONLINE_MEMORY：在线·记忆域。持有「记忆整合」那把 key（整合 / 会话压缩 /
# 候选提取共用）。**不要与对话域填同一把 key**：同 key 会让两个域共享一个缓存
# 空间、互相驱逐彼此的固定前缀，缓存命中率反而掉下去。
# 注意：整合会把群聊原文发到该服务商，切在线前请确认这在你的场景里可接受。
# LLM_ENDPOINT_ONLINE_MEMORY_BASE_URL=
# LLM_ENDPOINT_ONLINE_MEMORY_API_KEY=
# LLM_ENDPOINT_ONLINE_MEMORY_MODEL=
# LLM_ENDPOINT_ONLINE_MEMORY_KIND=online
# 记忆域是后台任务，并发度低于对话域：它不该抢对话的限流额度。
# LLM_ENDPOINT_ONLINE_MEMORY_CONCURRENCY=2
# LLM_ENDPOINT_ONLINE_MEMORY_TIMEOUT=120.0

# 槽 EXTRA：备用槽，**默认充当「本地记忆域」**——地址留空即继承上面的
# CONSOLIDATION_LM_STUDIO_BASE_URL（默认又继承 LM_STUDIO_BASE_URL，即同一个
# LM Studio），但闸门与 LOCAL 独立，于是整合与聊天真正并行。这正是改造前
# chat / consolidation 分两把锁的原因（27B 跑 GPU、E4B 跑 CPU）。
# 混合部署或调试时也可把它指向第三个服务。
# LLM_ENDPOINT_EXTRA_BASE_URL=
# LLM_ENDPOINT_EXTRA_API_KEY=
# 留空即可：CONSOLIDATION 角色会回落到 CONSOLIDATION_LM_STUDIO_MODEL。
# LLM_ENDPOINT_EXTRA_MODEL=
# 把上面的地址改指服务商时这里要一并改成 online（在 GUI 里改则自动推导）。
# LLM_ENDPOINT_EXTRA_KIND=local
# LLM_ENDPOINT_EXTRA_CONCURRENCY=1
# LLM_ENDPOINT_EXTRA_TIMEOUT=120.0

# ---------- LLM 角色（Role） ----------
# 角色 = 一个调用场景，引用一个端点槽 + 自己的模型 / 温度 / max_tokens。
# ENDPOINT 取 LOCAL | ONLINE_CHAT | ONLINE_MEMORY | EXTRA | none
# （none = 停用该角色，调用点会优雅退化而不是报错）。
# MODEL **通常不用填**：模型 ID 的正常出处是上面端点段的
# LLM_ENDPOINT_<槽>_MODEL，这里只是角色级覆盖（同一端点上某个角色要用别的模型）。
# 解析顺序：角色显式 MODEL → 该角色所绑端点的 MODEL → 注释里标出的那个旧键。
# 「显式」的判据是「值与它继承的旧键不同」，所以这一段整体注释掉时，
# 六个角色的行为逐项等于改造前。
#
# FALLBACK_ENDPOINT 留空 = 不降级。降级只在鉴权失败 / 限流 / 5xx 重试耗尽 /
# 连接超时时触发；400（请求体错误）**不降级**——那是配置问题，降级只会掩盖它。
# 典型用法：在线端点故障时回落本地，如 LLM_ROLE_CHAT_FALLBACK_ENDPOINT=LOCAL。

# 主对话生成
# LLM_ROLE_CHAT_ENDPOINT=LOCAL
# 留空即继承 LM_STUDIO_MODEL
# LLM_ROLE_CHAT_MODEL=
# LLM_ROLE_CHAT_TEMPERATURE=0.7
# LLM_ROLE_CHAT_MAX_TOKENS=2000
# LLM_ROLE_CHAT_FALLBACK_ENDPOINT=

# Router Level 2 兜底判定：「这次要不要动工具」的二分类。任务简单，
# 在线时用最廉价的模型就够。
# LLM_ROLE_ROUTER_ENDPOINT=LOCAL
# 留空即继承 LM_STUDIO_MODEL
# LLM_ROLE_ROUTER_MODEL=
# LLM_ROLE_ROUTER_TEMPERATURE=0.7
# LLM_ROLE_ROUTER_MAX_TOKENS=2000
# LLM_ROLE_ROUTER_FALLBACK_ENDPOINT=

# AstrBot 插件发起的 LLM 调用（messages 数组 / function calling / 图片）。
# LLM_ROLE_PLUGIN_ENDPOINT=LOCAL
# 下面三项留空即继承「AstrBot 插件的 LLM 服务」段的 ASTRBOT_LLM_*
# LLM_ROLE_PLUGIN_MODEL=
# LLM_ROLE_PLUGIN_TEMPERATURE=
# LLM_ROLE_PLUGIN_MAX_TOKENS=
# LLM_ROLE_PLUGIN_FALLBACK_ENDPOINT=

# 会话压缩：把较早的对话压成回顾。**在线时归记忆域**（与整合共用同一把 key），
# 让记忆域的流量与对话域的缓存互不干扰。
# LLM_ROLE_COMPACT_ENDPOINT=LOCAL
# 留空即继承 LM_STUDIO_MODEL
# LLM_ROLE_COMPACT_MODEL=
# LLM_ROLE_COMPACT_TEMPERATURE=0.3
# **0 = 按 SESSION_SUMMARY_MAX_TOKENS × 3 推导**（改造前的算法）。保持 0，
# 调大摘要长度时就不必同时改这里。
# LLM_ROLE_COMPACT_MAX_TOKENS=0
# LLM_ROLE_COMPACT_FALLBACK_ENDPOINT=

# 记忆整合 阶段1：短期摘要 + 用户画像 + 自我披露判断。默认端点是 EXTRA
# 而不是 LOCAL，理由见上面 EXTRA 槽的说明（闸门要与聊天分开）。
# LLM_ROLE_CONSOLIDATION_ENDPOINT=EXTRA
# 下面三项留空即继承「记忆整合」段的 CONSOLIDATION_LM_STUDIO_MODEL /
# CONSOLIDATION_LM_STUDIO_TEMPERATURE / CONSOLIDATION_LOCAL_MAX_TOKENS
# LLM_ROLE_CONSOLIDATION_MODEL=
# LLM_ROLE_CONSOLIDATION_TEMPERATURE=
# LLM_ROLE_CONSOLIDATION_MAX_TOKENS=
# LLM_ROLE_CONSOLIDATION_FALLBACK_ENDPOINT=

# 记忆整合 阶段2：从消息里精确提取「用户亲口说的、关于自己的稳定信息」。
# 只在阶段1 判定 has_self_disclosure=true 时唤醒，频次低但要求高精度。
# LLM_ROLE_EXTRACT_ENDPOINT=LOCAL
# 下面三项留空即继承「记忆候选提取」段的 MEMORY_EXTRACT_LM_STUDIO_MODEL /
# MEMORY_EXTRACT_LM_STUDIO_TEMPERATURE / MEMORY_EXTRACT_MAX_TOKENS
# LLM_ROLE_EXTRACT_MODEL=
# LLM_ROLE_EXTRACT_TEMPERATURE=
# LLM_ROLE_EXTRACT_MAX_TOKENS=
# LLM_ROLE_EXTRACT_FALLBACK_ENDPOINT=

# 降级总开关。关掉后主端点失败就是失败（各调用点自行退化），不切备用端点。
# LLM_FALLBACK_ENABLED=true
# 降级后多少秒再试探性回归主端点。太短会在厂商限流期间反复撞墙，
# 太长则厂商恢复了还在用备用端点。
# LLM_FALLBACK_COOLDOWN=300

# ---------- 成本控制：用量记账与每日预算 ----------
# 在线端点按 token 计费。用量按「日期 × 角色 × 端点槽 × 模型」记日账，
# 在 GUI「运行状态」页与 python -m deploy status 里可见（含缓存命中率）。
# 关掉记账等于关掉预算：没有用量数据，超额无从判断。
# LLM_USAGE_ACCOUNTING=true
# 每日 token 预算（输入+输出之和），0 = 不限。按本地日期在零点翻滚，重启不清零。
# LLM_DAILY_TOKEN_BUDGET=0
# 预算算哪些端点：online 只算在线（本地不花钱）/ all 全算
# LLM_BUDGET_SCOPE=online
# 撞破预算之后做什么：
#   pause_memory（默认）只停记忆域（整合/压缩/提取），群里照常能说话
#   pause_all     连对话一起停：被拦下的消息静默不回，只写一条 warn 日志
#   warn_only     只告警，从不拦任何调用
# LLM_BUDGET_EXHAUSTED_ACTION=pause_memory

# ---------- 主动发言 ----------
# 主动发言规则：按群聊消息频率插话（双锚点曲线，见下方「主动发言 v2」）——
# 频率越高越可能开口；消息稀疏到 INTERVAL_SLOW 锚点（平均间隔 >= INTERVAL_SLOW）时完全闭嘴。
# PROACTIVE_ENABLED=true
# PROACTIVE_COOLDOWN=600
# PROACTIVE_CHECK_INTERVAL=60
# 距上次自己发言，群里至少要有多少条新消息才允许再开口；0 表示不限制
# PROACTIVE_MIN_MESSAGES_SINCE_SPOKE=15
# PROACTIVE_FREQ_WINDOW=10
# PROACTIVE_MAX_LINES=1
# CONSOLIDATION_TRIGGER_NEW_MESSAGES=10

# ---------- 主动发言：睡眠时段 ----------
# 睡眠期间关闭一切主动发言（话题插话 + 主动 @），但被 @ 时照常回复；
# 被动信息收集（消息落库、整合）在睡眠期照常进行。
# PROACTIVE_SLEEP_ENABLED=true
# 睡眠起止（HH:MM，本地时间；START > END 时视为跨天区间）
# PROACTIVE_SLEEP_START=23:30
# PROACTIVE_SLEEP_END=07:30
# 醒来缓冲（秒）：苏醒后不立刻恢复主动发言，避免积压一夜的活跃度让它连发几句
# PROACTIVE_WAKEUP_GRACE_SECONDS=900.0
# 是否在入睡/苏醒时向群里播报一句
# PROACTIVE_SLEEP_ANNOUNCE=true
# 播报台词（逗号分隔多条，随机选一条；留空则不播报对应时段）
# PROACTIVE_SLEEP_MESSAGES=我先去睡了，晚安~,有点困了，明天聊,睡觉去了，你们别聊太晚
# PROACTIVE_WAKEUP_MESSAGES=早，我回来了,睡醒了，早上好,起床了~

# ---------- 主动发言：运行时开关 ----------
# 管理员可在群内临时关闭主动发言（持久化在 group_runtime_state 表，重启后仍生效）
# PROACTIVE_RUNTIME_TOGGLE_ENABLED=true
# 允许操作运行时开关的用户（QQ 号，逗号分隔）。留空则仅群主/管理员可操作。
# PROACTIVE_TOGGLE_ADMINS=

# ---------- 上下文 ----------
# 每次回复附加的最近原始消息条数（含 Bot 自己发言），补足摘要的滞后。
# 太小活跃群刷屏会把 Bot 提问挤出窗口、太大无关历史干扰模型，12 是起点。
# RECENT_TAIL_LIMIT=12
# 原始尾巴的时间窗（分钟）：超出该时长的消息不再算作「最近的对话」；0 不做时间过滤
# RECENT_TAIL_MAX_AGE_MINUTES=45.0
# 相邻消息间隔超过该分钟数时，在尾巴里插入断层标记；0 关闭
# RECENT_TAIL_GAP_MARK_MINUTES=15.0
# 话题摘要超过该分钟数未更新时，标题改为「之前的话题」并注明时长；0 关闭
# SHORT_TERM_SUMMARY_STALE_MINUTES=60.0

# ---------- 会话上下文压缩 ----------
# 短时连续对话中早期消息滚出尾巴窗口后会被压缩成摘要，保证长对话连贯。
# 会话摘要（已压缩部分）与原始尾巴按消息 id 严格划分、绝不重叠。
# SESSION_CONTEXT_ENABLED=true
# 待压缩文本超过该 token 估算值才触发压缩（不是每轮都压缩）
# SESSION_COMPACT_THRESHOLD_TOKENS=600
# 摘要自身的 token 预算：超过则连同新内容重新压缩一次
# SESSION_SUMMARY_MAX_TOKENS=300
# 单次压缩最多喂入多少条消息，防止长时间未压缩后一次性过大
# SESSION_COMPACT_MAX_MESSAGES=60
# 空闲多久视为会话结束（秒）：结束时清空摘要并触发一次完整整合
# SESSION_IDLE_TIMEOUT_SECONDS=900.0
# 空闲检查间隔（秒）
# SESSION_IDLE_CHECK_INTERVAL=300

# ---------- 主动发言 v2：话题参与概率曲线（双锚点插值） ----------
# 同一条曲线通过参数即可表达两种意图，无需模式开关：
#   「热闹时插话」（新默认）：PROB_AT_FAST=0.35, PROB_AT_SLOW=0.0
#   「热闹时闭嘴」（旧行为）：PROB_AT_FAST=0.05, PROB_AT_SLOW=0.5
#   完全关闭：两个锚点都设 0
# PROACTIVE_INTERVAL_FAST=20.0
# PROACTIVE_INTERVAL_SLOW=180.0
# PROACTIVE_PROB_AT_FAST=0.15   # 0.35 偏吵，0.15 为调低后的默认值
# PROACTIVE_PROB_AT_SLOW=0.0
# 曲线整形指数：1.0 线性；>1 把高概率压缩到最活跃一端（更保守）；<1 更平坦
# PROACTIVE_PROB_GAMMA=1.0
# 话题预热：话题刚开始时模型总结不出主题，贸然插话会答非所问
# PROACTIVE_TOPIC_WARMUP_SECONDS=45.0

# ---------- 主动发言 v2：每用户 @ 配额 ----------
# 主动 @ 是侵入性最强的行为，必须有硬上限。基础 2 次/天，高频发言者小幅上浮，
# 上限封顶在 BASE+BONUS_MAX，杜绝「越活跃越被骚扰」。
# PROACTIVE_AT_ENABLED=true
# PROACTIVE_AT_QUOTA_BASE=2
# PROACTIVE_AT_QUOTA_BONUS_MAX=2
# PROACTIVE_AT_BONUS_MSGS_LOW=20
# PROACTIVE_AT_BONUS_MSGS_HIGH=100
# 同一用户两次主动 @ 的最小间隔（秒），默认 2 小时
# PROACTIVE_AT_USER_COOLDOWN=7200.0
# 判定「正在活跃」的时间窗（秒）
# PROACTIVE_AT_ACTIVE_WITHIN=300.0
# 连续无回应上限：超过则暂停对该用户的主动 @
# PROACTIVE_MAX_NO_REPLY=2
# 回应检测窗口（秒）
# PROACTIVE_REPLY_WINDOW_SECONDS=300.0
# 冷启动话题清单（无候选可验证时用，逗号分隔）
# PROACTIVE_COLDSTART_TOPICS=最近在玩什么游戏,平时喜欢吃什么,今天天气怎么样,最近在忙什么,平时用什么设备
# 主动 @ 的排除名单（QQ 号，逗号分隔）：主要用途是排除群内其他 AI，
# 互相 @ 会触发无终止的循环对话。被排除的账号仍会被动收集信息。
PROACTIVE_AT_EXCLUDE_USERS=
# 不参与「主动验证」的候选类型（逗号分隔；留空 = 所有类型都可以被追问）。
# 主动 @ 的配额极稀缺，而验证是为了把候选推成**长期**记忆——时效信息等确认下来
# 时早已过期，「你听到地震预警了吗」隔一周问也很荒谬。这些候选照常落库，
# 只是不会为它们去打扰用户。
# PROACTIVE_VERIFY_EXCLUDE_TYPES=EVENT,PLAN,GROUP_CONTEXT

# ---------- 输出 ----------
# MAX_REPLY_LINES=5
# SEND_INTERVAL=0.8

# ---------- 记忆系统 v2（可调阈值，越高越保守） ----------
# Mode 检测打分制的最低分：低于该值的信号不值得把模式从 CASUAL_REPLY 改判
# MODE_DETECT_MIN_SCORE=0.5
# 记忆进入 Prompt 的最低排序分（宁缺毋滥，配合 --verbose 的 scores 分布来调）
# MEMORY_SCORE_MIN=0.40

# ---------- 消息来源分级（source_kind，默认开启） ----------
# @ 对话是唯一稳定的用户信息源，被动摄入的群聊多为角色扮演、可提取信息极少。
# 关闭后 prompt 不标注来源、候选不加置信度奖励（退回旧「消息等权」行为），
# 但 schema 的 source_kind 字段仍会写入，便于审计回看。
# MEMORY_SOURCE_KIND_ENABLED=true
# AT_MENTION 来源候选的置信度奖励（仅微调，默认 0.05）
# MEMORY_AT_MENTION_CONFIDENCE_BONUS=0.05

# ---------- 候选强化（交叉验证） ----------
# 同一事实被再次独立观察到时的置信度增益（默认 0.12：0.5 起步约 2 次复现后跨过 0.6 观察门槛）
# MEMORY_CANDIDATE_REOCCURRENCE_BONUS=0.12
# 候选在 OBSERVING 停留的最长天数，超期未获新证据即标 REJECTED（默认 30）
# MEMORY_CANDIDATE_MAX_OBSERVING_DAYS=30
# evidence 字段累积上限（字符），防止多次复现导致的无限增长（默认 800）
# MEMORY_CANDIDATE_EVIDENCE_MAX_CHARS=800
# 模型没给 importance 时的兜底值（默认 0.5）。**不要设成 0**：0 会被
# MEMORY_PROMOTE_MIN_IMPORTANCE 一票否决，候选从此永远卡在 OBSERVING，
# 还会被主动验证反复挑中去追问同一个人同一件事
# MEMORY_CANDIDATE_DEFAULT_IMPORTANCE=0.5

# ---------- 晋升门槛（Gate 1 三档分级） ----------
# 纯 PASSIVE 来源晋升所需的最低独立观察次数（默认 2：复现才是证据，单次陈述不算）
# MEMORY_PROMOTE_MIN_OCCURRENCE_PASSIVE=2
# AT_MENTION（用户直接对 Bot 说）是高密度证据，单次即可晋升（默认 true；
# 关闭后与 PASSIVE 同等对待、仍需复现）
# MEMORY_PROMOTE_AT_MENTION_SINGLE_SHOT=true
# 晋升所需的最低重要度，淘汰过于琐碎的信息（默认 0.3；不单独构成晋升依据）
# MEMORY_PROMOTE_MIN_IMPORTANCE=0.3

# ---------- 每用户记忆配额（宁缺毋滥的硬约束） ----------
# 是否真正执行淘汰。建议先保持 false 观察日志：以 dry-run 输出「本来会淘汰谁」，
# 确认淘汰对象合理后再打开。打开后超额记忆置 archived（不删除，但退出检索）。
# MEMORY_QUOTA_ENFORCE=false
# 单用户在单群的 active 记忆上限，到顶后新记忆挤掉现存最弱的一条（默认 25）
# MEMORY_USER_QUOTA=25
# 配额淘汰排序权重（得分最低者先被挤掉）：
#   importance=信息本身多重要；confirmation=被反复确认次数（最硬证据）；
#   recency=最近是否仍被触达（久未触碰价值衰减）
# MEMORY_QUOTA_W_IMPORTANCE=0.4
# MEMORY_QUOTA_W_CONFIRMATION=0.3
# MEMORY_QUOTA_W_RECENCY=0.3
# confirmation_count 归一化上限：达到该次数即视为充分确认（满分）（默认 3）
# MEMORY_QUOTA_CONFIRMATION_CAP=3

# ---------- 记忆语义检索（可选，Embedding） ----------
# 默认关闭：语义分用规则版（词面 Jaccard，离线）。打开后走本地 LM Studio /v1/embeddings
# 计算查询与记忆的余弦相似度，语义分真正可区分；模型不可用时自动回退规则版。
# MEMORY_EMBEDDING_ENABLED=false
# MEMORY_EMBEDDING_BASE_URL=http://127.0.0.1:1234
# MEMORY_EMBEDDING_MODEL=
# MEMORY_EMBEDDING_TIMEOUT=10.0
# embedding 恒定跑本地，不随 LLM 切到在线（它要为整库记忆算向量，在线按量计费扛不住，
# 且换模型会让已存向量全部失效）。这里只决定它占用哪道闸门：
#   auto   = 自动判定（默认）：存在 KIND=local 且地址与 MEMORY_EMBEDDING_BASE_URL
#            相同的端点槽时共用该槽闸门，否则独立不排队。doctor 会打印判定结果。
#   none   = 独立不排队（embedding 跑在专用实例上时用）
#   <槽名> = 固定占某个槽的闸门，如 LOCAL / EXTRA
# MEMORY_EMBEDDING_GATE=auto
# embedding 路径下 CONTEXTUAL 记忆的主题匹配阈值（余弦）；rule-only 用 policy 内置 0.05
# MEMORY_EMBEDDING_CONTEXTUAL_MIN=0.25

# ---------- 数据库清理（测试期用，默认关闭） ----------
# DB_CLEANUP_ON_START=false
# DB_CLEANUP_CLEAR_MESSAGES=false

# ---------- 消息表定期清理 ----------
# 是否启用 group_messages 定期清理（每天定时清理）
# MESSAGE_CLEANUP_ENABLED=true
# 每个群保留的最近消息条数（超出部分删除）
# MESSAGE_CLEANUP_KEEP_COUNT=1000
# 定时清理执行时间（24 小时制）
# MESSAGE_CLEANUP_HOUR=4
# 清理时是否保护未整合的消息（checkpoint 之后的消息不删除，默认 true）
# MESSAGE_CLEANUP_PROTECT_UNCONSOLIDATED=true

# ============================================================
# 群组共享空间（不在本文件配置）
# ============================================================
# 多个 QQ 群可归入同一「共享空间」以共享用户画像、长期记忆与人格。
# 配置在 config/spaces/*.toml（空间名、system prompt 文件、群号），不走 .env。
# 默认人格文件为项目根目录 system_prompts/default.md；缺失时最后回退 memory/SYSTEM.md。
# 未被任何 toml 收录的群会自动分配 space_N 并持久化。
# 详见 docs/configuration.md 的「群组共享空间」一节。

# ---------- 结构化日志（供 GUI / 前端消费，默认开启） ----------
# 与人类可读日志并存：这份是给程序读的，GUI 靠它做级别过滤与错误复制。
# 全项目唯一带轮转与保留策略的日志（10 MB 轮转、保留 5 份）。
# STELLA_JSON_LOG_ENABLED=true
# 留空即 LOG_DIR/stella.jsonl。`deploy status` 与 GUI 都读这个配置，不要在别处另拼路径。
# STELLA_JSON_LOG_PATH=
# 单条消息的截断长度（prompt 全文动辄数千字符，进结构化日志只会让文件暴涨）
# STELLA_JSON_LOG_MAX_MESSAGE=500

# ---------- 本地状态接口 ----------
# 挂在 NoneBot 已有的 ASGI app 上（HOST:PORT/stella/status），不新增端口。
# 只接受回环地址的请求，且响应体不含凭据与群聊内容——HOST 可能是 0.0.0.0，
# 那时本路由也会暴露到局域网。供 deploy status 与 GUI 读取进程内状态。
# STELLA_STATUS_API_ENABLED=true
# STELLA_STATUS_API_PATH=/stella/status

# ---------- 优雅停止 ----------
# 停止时等待在途后台任务（整合/压缩）收尾的上限（秒）。
# LLM 单次调用最长 120s×3 次重试，无限等待会让「停止」看起来卡死。
# SHUTDOWN_GRACE_SECONDS=30.0
# 停止请求哨兵路径（deploy stop 写入、Bot 内 watcher 观察后自行退出）。
# 默认项目根 .stella-stop-request；项目目录只读时可改到可写位置。
# STELLA_STOP_SENTINEL=
# 哨兵轮询间隔（秒）。
# STOP_WATCH_INTERVAL_SECONDS=0.5

# ---------- AstrBot 插件兼容层 ----------
# 将 AstrBot 生态的第三方插件直接放入 data/plugins/<插件目录>/ 即可。
# 仅支持不依赖大模型能力的功能类插件；依赖模型的插件需官方移植。
# ASTRBOT_COMPAT_ENABLED=true
# ASTRBOT_COMPAT_VERSION=4.27.0
# ASTRBOT_PLUGINS_DIR=
# ASTRBOT_PLUGIN_CONFIG_DIR=
# ASTRBOT_PLUGIN_DATA_DIR=
# ASTRBOT_AUTO_INSTALL_REQUIREMENTS=false
# 指令唤醒前缀（逗号分隔）。上游默认 "/"：群里直接打 /help 即可触发插件指令，
# 不必先 @ 机器人。留空则只认 @ / 引用机器人 / 私聊。
# ASTRBOT_WAKE_PREFIXES=/
# 是否允许私聊消息触发插件（上游私聊无需唤醒前缀）。
# ASTRBOT_COMPAT_ALLOW_PRIVATE=true

# ---------- HTML → 图片渲染（插件卡片） ----------
# 大量 AstrBot 插件把结果卡片做成 Jinja2 模板 + CSS，靠 Star.html_render 出图。
# 后端是**本地 Chromium**：模板里填的是群友昵称、动态正文、头像 URL，属于聊天内容；
# 上游 AstrBot 默认把 HTML 发到远程 t2i 服务，Stella 不走那条路——其他环节
# （对话模型、embedding、整合）全在本地，渲染没理由成为唯一出网的一环。
# RENDER_ENABLED=true
# 浏览器缺失时自动后台下载内核（headless shell，约 270MB，视网络几分钟）。
# 下载期间照常降级（插件回纯文本），装好后自动生效、不需要重启。
# 关掉它就得手工跑一次： <python> -m playwright install chromium-headless-shell
# 只装 headless shell 是刻意的：我们永远只截图，完整 chromium 会多拉一倍多的体积。
# RENDER_AUTO_INSTALL=true
# 自动安装失败后的冷却（秒）。没有冷却的话每条带链接的消息都会重新拉一次几百 MB。
# RENDER_INSTALL_RETRY_SECONDS=3600
# 渲染产物目录。不放 logs/——这是要发出去的图片，不是日志。
# RENDER_CACHE_DIR=data/render_cache
# 保留最近多少张产物（每张几百 KB，不清理会无声涨到几个 G）
# RENDER_CACHE_KEEP=50
# 同时最多渲染几张。渲染挂在聊天主链路上，并发高了不会更快，只会一起变慢。
# RENDER_MAX_CONCURRENCY=2
# 页面 load 完之后再等多少毫秒截图（给 Web 字体与渐变留稳定时间）
# RENDER_SETTLE_MS=300
# text_to_image / t2i 出图的宽度（像素）
# RENDER_TEXT_WIDTH=800

# ---------- AstrBot 插件的 LLM 服务 ----------
# 插件通过 context.get_using_provider_async() / event.request_llm() 调模型时走这里。
# 与主聊天链路共用同一个本地模型，但走独立的 OpenAI 兼容客户端——插件需要
# messages 数组 / function calling / 图片，主链路的 generate() 表达不了。
# 所有插件调用都经 chat 闸门排队，与主对话 FIFO 串行（本地只有一块 GPU）。
# ASTRBOT_LLM_ENABLED=true
# 默认继承 LM_STUDIO_*，需要让插件用另一个模型时才单独设置
# ASTRBOT_LLM_BASE_URL=
# ASTRBOT_LLM_MODEL=
# ASTRBOT_LLM_API_KEY=
# ASTRBOT_LLM_TEMPERATURE=0.7
# 插件专属人格：插件没给 system_prompt 时注入这一句。
# 刻意不用 Stella 的人格——插件的回复不该带 Stella 的语气，否则用户分不清是谁在说话；
# 但完全不给 system 消息又会让本地模型输出风格漂移，所以给一句最小的锚。
# 设为空串则彻底不发 system 消息。
# ASTRBOT_LLM_SYSTEM_PROMPT=你是一个简单的机器人助手，请直接、简短地回答，不要扮演角色。
# 单次回复的生成预算
# ASTRBOT_LLM_MAX_TOKENS=1024
# 送出前的上下文预算（估算值）。超出时从最早的非 system 消息开始丢弃。
# 本地 8192 窗口的模型保持默认即可；换更大窗口的模型时调大这里。
# 会撑爆窗口的主要是两样：插件的多轮对话历史、以及函数工具的 schema。
# ASTRBOT_LLM_MAX_CONTEXT_TOKENS=8192
# 单次请求最多携带多少个函数工具。每个约 60~120 token，装满插件时很容易吃掉上下文。
# ASTRBOT_LLM_MAX_TOOLS=32
# 单个工具调用的超时（秒）
# ASTRBOT_LLM_TOOL_TIMEOUT=120
# 工具调用循环的最大轮数，防止模型反复调用工具打转
# ASTRBOT_LLM_MAX_TOOL_STEPS=10

# ---------- Capability Router（能力路由） ----------
# 判断一次请求需要哪些能力（聊天 / 记忆 / 工具），避免把所有插件工具的 schema
# 都塞进 Stella 的聊天上下文——8192 的工作窗口装不下几十个工具描述，且工具描述
# 会干扰正常聊天。设计见 design_docs/Capability Router 与 Comes 落地方案 v1.0.md。
#
# **声明优先**：要让一个插件工具能在聊天里被触发，得在 config/capabilities/*.toml
# 里给它写一条 [[capability]]（格式见同目录的 .example）。没有声明的工具照常注册、
# 仍可被显式执行，但不参与语义路由——启动日志会点名有哪些。
# CAPABILITY_ROUTER_ENABLED=true
# 没有声明的插件工具（自动派生成 tool.<工具名>）是否参与路由竞争。默认 false。
# 理由：工具描述是写给「看着全部工具做选择」的决策器的指令句，拿它当语义原型时同域
# 工具几乎没有区分度。2026-08-24 实测（5 个 bgm/bilibili 工具）——自动派生：工具假阳 1、
# 首位选错 2/5、无关工具被执行 13 次；改成带中文 examples 的声明后三项都归零。
# ⚠️ 设成 true 时必须同时下调下面三条阈值：自动派生的打分整体低约 0.2（正样本只到
# 0.61~0.71），否则工具会静默地永远不触发。
# ROUTER_ROUTE_AUTO_CAPABILITIES=false
# Level 0：关键词规则快速判断。零延迟、不调模型，处理高置信度请求。
# ROUTER_RULE_ENABLED=true
# Level 1：Embedding 语义路由。复用 MEMORY_EMBEDDING_* 的服务地址与模型。
# ROUTER_SEMANTIC_ENABLED=true
# Level 2：更强模型兜底。默认关闭——只在 L1 落入不确定带时才值得花一次 27B 推理，
# 建议先用 `python -m capability.router.benchmark` 量出 L0/L1 的准确率再决定。
# 已知的一类假阳只有 L2 能治：余弦分不开「陈述 X」和「请求 X」（实测「我最近在追新番」
# 得 0.835，与「有什么值得追的新番吗」高度相似），抬阈值治不了。
# ROUTER_FALLBACK_ENABLED=false
#
# 下面四条是一组，2026-08-25 用 qwen3-embedding-0.6b 在 12 条用例上标定，
# 前提是能力带中文 examples。复现：
#   python -m capability.router.benchmark --cases capability/router/benchmark/acg.json
# 实测分布：负样本上界 0.559 / 正样本下界 0.851。
#
# 能力进入候选列表的绝对地板。真正起作用的是下面的 MARGIN，本项只压日志长尾噪声。
# ROUTER_SEMANTIC_THRESHOLD=0.50
# 判定 tool=true 所需的最高分置信线。0.70 取两个分布的中点，两侧余量 +0.141/+0.151。
# ROUTER_TOOL_THRESHOLD=0.70
# 命中能力允许比最高分低多少（相对间距裁剪）。0 表示不裁剪。
# 治的是「搭车能力」：一旦 tool=true，所有过了绝对地板的能力都会各自执行一次，
# 于是「帮我推荐一些新番」同时调了每日放送和 B 站热门视频。绝对地板治不了它——
# 实测正确能力 0.851~0.911、搭车 0.616~0.743，搭车高于任何不误杀正样本的地板值。
# 0.12 在 0.08~0.15 这个平台的中间（该区间内搭车数恒为 0）。
# ROUTER_CAPABILITY_MARGIN=0.12
# 不确定带下界：最高分低于它就是「确定不需要工具」，不进 Level 2。
# 0.55 紧贴实测负样本上界，于是不确定带 = 0.55~0.70，只覆盖真正含混的那一小段。
# ROUTER_UNCERTAIN_FLOOR=0.55
#
# 单次请求最多路由几个能力。每个能力在 Comes 里是一次独立的受限 agent 调用，
# 都走 chat 闸门串行，不设上限会让一条消息卡住整个群的回复。
# ROUTER_MAX_CAPABILITIES=3
# 是否真的按 route.memory 门控长期记忆检索。
# **默认关闭**：Router 误判 memory=false 会让 Stella 当轮悄悄丢失长期记忆——不抛异常、
# 不影响回复，只是「它突然不记得你了」。先跑 benchmark 确认记忆假阴为 0 再打开：
#   python -m capability.router.benchmark
# ROUTER_GATE_MEMORY=false
# 单次路由判定的超时（秒）。超时按降级处理（chat+memory，不调工具），不阻塞回复。
# ROUTER_TIMEOUT=8.0

# ---------- Comes（工具执行层） ----------
# Comes 只负责「能力 → 找 Provider → 调 Tool → 返回 Result」，不理解用户、不管人格。
# 它用一个受限 agent 驱动工具：请求里只有 COMES_SYSTEM_PROMPT + 任务目标 +
# 本次命中能力的 1~3 个工具 schema，既没有 Stella 的人格也没有聊天上下文。
# 反过来 Stella 只拿到压缩后的 summary，看不到任何工具 schema 与原始返回。
# COMES_ENABLED=true
# Comes 的执行器人格。刻意不用 Stella 的人格——它的输出只是给 Stella 看的中间结果。
# COMES_SYSTEM_PROMPT=你是一个工具执行器。根据给定的任务目标，选择合适的工具并填好参数。只调用工具，不要闲聊，不要扮演角色。拿到工具结果后用一句中文陈述事实即可。
# 单个任务的工具调用最大轮数。比 ASTRBOT_LLM_MAX_TOOL_STEPS(10) 小：
# Comes 是单一能力的定向执行，需要 5 轮以上通常意味着模型在打转。
# COMES_MAX_TOOL_STEPS=5
# 单个工具调用的超时（秒）。比 ASTRBOT_LLM_TOOL_TIMEOUT(120) 短得多——
# Comes 挂在聊天主链路上，用户在等回复，不能为一个工具等两分钟。
# COMES_TOOL_TIMEOUT=60
# 单个任务的总超时（秒），含模型往返与工具执行。超时按 failed 处理并照常回复。
# COMES_TASK_TIMEOUT=90
# 进 Stella prompt 的结果摘要长度上限（字符）
# COMES_SUMMARY_MAX_CHARS=300
# 命中能力只有一个 provider、且其工具没有必填参数时，跳过 LLM 直接调工具。
# 省一次 27B 往返，且不可能填错参数。
# COMES_DIRECT_CALL_NO_ARGS=true
# 连续失败多少次后临时退避一个 provider。0 表示不退避。
# 退避是时间窗而非永久禁用：插件依赖的外部 API 抖动是常态。
# COMES_PROVIDER_FAILURE_THRESHOLD=3
# 被退避的 provider 多久后恢复（秒）
# COMES_PROVIDER_RECOVER_SECONDS=600
