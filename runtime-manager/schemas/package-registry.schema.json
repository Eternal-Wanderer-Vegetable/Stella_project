{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stella Installed Package Registry",
  "type": "object",
  "required": ["schema_version", "updated_at", "packages", "active", "history"],
  "properties": {
    "schema_version": {"const": 1},
    "updated_at": {"type": "string", "minLength": 1},
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "id", "version", "path", "checksum"],
        "properties": {
          "kind": {"enum": ["runtime", "component", "model", "onebot"]},
          "id": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "checksum": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
          "platform": {"type": "string"},
          "installed_at": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "active": {"type": "object", "additionalProperties": {"type": "string"}},
    "history": {"type": "array", "items": {"type": "object"}}
  },
  "additionalProperties": false
}
